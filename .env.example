# GV Wohnungen – Environment
# Kopiere diese Datei als .env und fülle die Werte aus
# (Vom Vercel/Neon PostgreSQL Dashboard kopieren)

# PostgreSQL Datenbank (Neon oder andere)
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/gv-wohnungen?sslmode=require

# Apify API Token (optional, für den Apify Flatfox-Scraper)
# APIFY_API_TOKEN=apify_token_xxx

# Max Miete für Scrape-Filter (CHF)
# MAX_RENT=1500